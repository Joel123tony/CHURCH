NODE_ENV=development
PORT=8080
USE_MOCK_DB=true
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/church
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-channel-id
PUBLIC_WEB_URL=https://church.com
ADMIN_WEB_URL=https://admin.church.com
API_BASE_URL=https://api.church.com
VITE_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=https://church.com,https://admin.church.com
SEED_ADMIN_NAME=Church Admin
SEED_ADMIN_EMAIL=admin@church.com
SEED_ADMIN_PASSWORD=change-me-now
